PORT=3000

# Database Provider: 'sqlite' for zero-dependency local testing without Docker
DB_TYPE=sqlite

# PostgreSQL Configuration (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fintech_user
DB_PASSWORD=fintech_secret
DB_DATABASE=fintech_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Idempotency Configuration
IDEMPOTENCY_TTL_SECONDS=86400
